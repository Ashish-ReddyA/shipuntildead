11:["$","div",null,{"className":"story-layout","children":[["$","aside",null,{"className":"story-index","children":[["$","p",null,{"className":"index-heading","children":"In this edition"}],["$","nav",null,{"aria-label":"Project sections","children":[["$","a",null,{"href":"#before-and-after","children":"Before / After"}],["$","a",null,{"href":"#the-idea","children":"The idea"}],["$","a",null,{"href":"#what-it-does","children":"What it does"}],["$","a",null,{"href":"#how-it-works","children":"How it works"}],["$","a",null,{"href":"#in-practice","children":"In practice"}],["$","a",null,{"href":"#sources","children":"Go deeper"}]]}],["$","dl",null,{"children":[["$","div","Focus",{"children":[["$","dt",null,{"children":"Focus"}],["$","dd",null,{"children":"Image & video prompts"}]]}],["$","div","Access",{"children":[["$","dt",null,{"children":"Access"}],["$","dd",null,{"children":"Web app source + MCP tools"}]]}],["$","div","AI setup",{"children":[["$","dt",null,{"children":"AI setup"}],["$","dd",null,{"children":"Bring your own provider key"}]]}]]}]]}],["$","div",null,{"className":"story-content","children":[["$","section",null,{"id":"the-idea","children":[["$","p",null,{"className":"section-marker","children":"The idea"}],["$","h2",null,{"children":"Ask first. Generate with intent."}],["$","p",null,{"children":"A generation can look impressive and still miss the brief. The wrong format, an unspecified camera movement, or a forgotten detail means another paid attempt. This project puts a short clarification loop before generation, so the tool receives a more complete description of what you actually want."}]]}],["$","section",null,{"id":"what-it-does","children":[["$","p",null,{"className":"section-marker","children":"What it does"}],["$","h2",null,{"children":"The moving parts."}],["$","div",null,{"className":"feature-list","children":[["$","div","Questions grounded in your idea",{"className":"feature","children":[["$","h3",null,{"children":"Questions grounded in your idea"}],["$","p",null,{"children":"The AI identifies the subjects and setting in your description, then asks focused questions about each. An idea about a barista pouring a latte can become separate questions about the barista, drink, café, and scene. Multi-select answers allow compatible details to coexist."}]]}],["$","div","One prompt for each platform",{"className":"feature","children":[["$","h3",null,{"children":"One prompt for each platform"}],["$","p",null,{"children":"Answers become a coherent description, then deterministic compilers add the platform-specific structure. Image targets include Midjourney, DALL·E, and Higgsfield; video targets include Higgsfield, Veo 3, and Runway."}]]}],["$","div","Visible gaps before you spend",{"className":"feature","children":[["$","h3",null,{"children":"Visible gaps before you spend"}],["$","p",null,{"children":"A completeness meter counts unanswered required fields. You can fill them in or explicitly choose to compile anyway. Technical choices such as aspect ratio and duration remain direct controls."}]]}],["$","div","A way to test the idea itself",{"className":"feature","children":[["$","h3",null,{"children":"A way to test the idea itself"}],["$","p",null,{"children":"After copying a prompt, you can record whether the result worked first time, needed more attempts, or was abandoned. Local statistics compare complete and incomplete specs. Reduced regeneration is a hypothesis being measured, not a promised result."}]]}]]}]]}],["$","section",null,{"id":"how-it-works","children":[["$","p",null,{"className":"section-marker","children":"How it works"}],["$","h2",null,{"children":"From idea to action."}],["$","ol",null,{"className":"workflow","children":[["$","li","Describe the idea",{"children":[["$","span",null,{"className":"step-number","aria-hidden":"true","children":["0",1]}],["$","div",null,{"children":[["$","h3",null,{"children":"Describe the idea"}],["$","p",null,{"children":"Choose image or video and enter what you wa