16:["$","section",null,{"id":"in-practice","children":[["$","p",null,{"className":"section-marker","children":"In practice"}],["$","h2",null,{"children":"Before you dive in."}],[["$","p","The app prepares prompts; it does not generate the final images or videos. The current implemented domains are image and video. Coding and broader requirement graphs remain future work.",{"children":"The app prepares prompts; it does not generate the final images or videos. The current implemented domains are image and video. Coding and broader requirement graphs remain future work."}],["$","p","The Next.js app lives in spec-compiler-mvp. Install its dependencies and run npm run dev to use it locally. MCP integrations expose elicit_spec and compile_spec for compatible assistants.",{"children":"The Next.js app lives in spec-compiler-mvp. Install its dependencies and run npm run dev to use it locally. MCP integrations expose elicit_spec and compile_spec for compatible assistants."}],["$","p","Specs and outcomes persist in the browser. Provider keys are stored locally; Anthropic requests are browser-direct, while other supported providers use a same-origin pass-through proxy that does not store the key. AI questions require a key; the fixed form remains available without one.",{"children":"Specs and outcomes persist in the browser. Provider keys are stored locally; Anthropic requests are browser-direct, while other supported providers use a same-origin pass-through proxy that does not store the key. AI questions require a key; the fixed form remains available without one."}]]]}]
